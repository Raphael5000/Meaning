# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key

# NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your_nextauth_secret

# App URL (must match Google OAuth authorized redirect URIs)
# For connect-google (GA), add this exact redirect URI in Google Cloud Console:
#   http://localhost:3001/api/auth/connect-google/callback
# (Use https and your production domain in production.)
NEXTAUTH_URL=http://localhost:3001

# Database — PostgreSQL (Supabase). Required for OAuth and account creation.
# Prod: use Connection pooling → Session mode (port 6543). Direct (db.xxx:5432) often fails from cloud with P1001.
# Supabase: Project Settings → Database → Connection string → Session mode URI.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key
# Optional: override sender address (default: Meaning <alerts@usemeaning.io>)
# RESEND_FROM_EMAIL="Meaning <alerts@usemeaning.io>"
# Secret for cron job authentication (generate with: openssl rand -base64 32)
CRON_SECRET=your_cron_secret

# LinkedIn OAuth (from developer.linkedin.com)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Mailchimp OAuth (from admin.mailchimp.com/account/oauth2/client/)
MAILCHIMP_CLIENT_ID=your_mailchimp_client_id
MAILCHIMP_CLIENT_SECRET=your_mailchimp_client_secret

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# Plan code from Paystack dashboard (e.g. PLN_abc123xyz), NOT the plan display name
PAYSTACK_PLAN_CODE=PLN_your_plan_code

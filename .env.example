# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key

# NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your_nextauth_secret

# App URL
NEXTAUTH_URL=http://localhost:3001

# Database — PostgreSQL (Supabase). Required for OAuth and account creation.
# Local: use a Supabase project (free tier) or local Postgres; prod: your Supabase DB.
# Supabase: Project Settings → Database → Connection string (URI). Use Session mode / direct connection for migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# Plan code from Paystack dashboard (e.g. PLN_abc123xyz), NOT the plan display name
PAYSTACK_PLAN_CODE=PLN_your_plan_code

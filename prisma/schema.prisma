generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// NextAuth core models
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  gaConnected   Boolean @default(false) // true after user completes GA onboarding

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Paystack
  paystackCustomerCode String?

  // Relations
  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  payments     Payment[]
  chats        Chat[]
  emailAlerts  EmailAlert[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Subscription & Payment
// ──────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  status String @default("active") // active | cancelled | past_due | trialing
  plan   String @default("monthly") // monthly

  paystackSubscriptionCode String?
  paystackEmailToken       String?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// Chat History
// ──────────────────────────────────────────────

model Chat {
  id           String   @id @default(cuid())
  userId       String
  title        String
  propertyId   String?  // GA4 property id associated with this chat
  propertyName String?  // GA4 property display name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id                 String  @id @default(cuid())
  chatId             String
  role               String  // "user" | "assistant"
  content            String
  scorecard          Json?   // { value, label, change? }
  scorecardRevealed  Boolean @default(false)
  suggestedQuestions Json?   // string[]
  sortOrder          Int     // ordering within the chat

  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

// ──────────────────────────────────────────────
// Email Alerts
// ──────────────────────────────────────────────

model EmailAlert {
  id     String @id @default(cuid())
  userId String

  recipients   String   // comma-separated email addresses
  frequency    String   // "daily" | "weekly" | "monthly"
  alertType    String   @default("weekly_snapshot") // alert prompt template key
  propertyId   String?  // GA4 property id
  propertyName String?  // GA4 property display name
  enabled      Boolean  @default(true)
  lastSentAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, frequency])
}

model Payment {
  id     String @id @default(cuid())
  userId String

  amount   Int    // in kobo/cents
  currency String @default("ZAR")
  status   String // success | failed | pending

  paystackReference     String  @unique
  paystackTransactionId String?

  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

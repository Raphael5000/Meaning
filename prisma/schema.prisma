generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// NextAuth core models
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  gaConnected   Boolean @default(false) // true after user completes GA onboarding
  theme         String  @default("system") // "light" | "dark" | "system"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Paystack
  paystackCustomerCode        String?
  paystackAuthorizationCode   String?

  // Relations
  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  payments     Payment[]
  chats        Chat[]
  emailAlerts  EmailAlert[]
  teamOwned    Team?            @relation("TeamOwner")
  memberships  TeamMembership[]
  dataSources  DataSource[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Subscription & Payment
// ──────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  status    String @default("active") // active | cancelled | past_due | trialing
  plan      String @default("monthly") // monthly
  seatCount Int    @default(1)

  paystackSubscriptionCode String?
  paystackEmailToken       String?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// Chat History
// ──────────────────────────────────────────────

model Chat {
  id           String   @id @default(cuid())
  userId       String
  title        String
  propertyId   String?  // GA4 property id associated with this chat
  propertyName String?  // GA4 property display name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id                 String  @id @default(cuid())
  chatId             String
  role               String  // "user" | "assistant"
  content            String
  scorecard          Json?   // { value, label, change? }
  scorecardRevealed  Boolean @default(false)
  suggestedQuestions Json?   // string[]
  chart              Json?   // ECharts option JSON
  sortOrder          Int     // ordering within the chat

  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

// ──────────────────────────────────────────────
// Email Alerts
// ──────────────────────────────────────────────

model EmailAlert {
  id     String @id @default(cuid())
  userId String

  recipients   String   // comma-separated email addresses
  alertType    String   @default("weekly_snapshot") // alert prompt template key
  customPrompt String?  // user-defined prompt for "custom" alertType
  propertyId   String?  // GA4 property id
  propertyName String?  // GA4 property display name
  enabled      Boolean  @default(true)
  lastSentAt   DateTime?

  // Custom schedule fields
  sendDays      String[] @default(["monday"]) // e.g. ["monday", "wednesday", "friday"]
  sendHour      Int      @default(9)          // 0-23, hour of day in UTC
  sendMinute    Int      @default(0)          // 0 or 30
  intervalWeeks Int      @default(1)          // 1 = every week, 2 = biweekly, 4 = monthly

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, sendHour])
}

model Payment {
  id     String @id @default(cuid())
  userId String

  amount   Int    // in kobo/cents
  currency String @default("ZAR")
  status   String // success | failed | pending

  paystackReference     String  @unique
  paystackTransactionId String?

  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// Team Management
// ──────────────────────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  TeamMembership[]
  invites      TeamInvite[]
  dataSources  DataSource[]
}

model TeamMembership {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("member") // "admin" | "member"
  properties String[] // GA4 property IDs this member can access
  createdAt  DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email      String
  properties String[]
  token      String    @unique @default(cuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([teamId, email])
}

// ──────────────────────────────────────────────
// Articles / Docs (database-backed content)
// ──────────────────────────────────────────────

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  category    String   @default("getting-started")
  type        String   @default("article") // article | video | guide
  readTime    String?
  duration    String?
  featured    Boolean  @default(false)
  author      String?
  keywords    String[] @default([])
  content     String   // raw MDX content (including frontmatter)
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ──────────────────────────────────────────────
// Data Sources (BigQuery integration)
// ──────────────────────────────────────────────

model DataSource {
  id         String   @id @default(cuid())
  userId     String
  teamId     String?
  type       String   @default("GA4_BIGQUERY") // GA4_BIGQUERY | STRIPE | SEARCH_CONSOLE | HUBSPOT
  propertyId String                            // GA4 property ID
  bigqueryDataset String?                      // e.g. "analytics_123456789"
  status     String   @default("PENDING")      // PENDING | ACTIVE | ERROR

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId, type])
  @@index([userId])
  @@index([propertyId])
}

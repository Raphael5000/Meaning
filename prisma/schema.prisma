generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// NextAuth core models
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  gaConnected   Boolean @default(false) // true after user completes GA onboarding
  theme         String  @default("system") // "light" | "dark" | "system"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // LemonSqueezy
  lsCustomerId   String?

  activeOrgId  String?

  // Relations
  accounts       Account[]
  sessions       Session[]
  subscription   Subscription?
  payments       Payment[]
  chats          Chat[]
  emailAlerts    EmailAlert[]
  teamOwned      Team?            @relation("TeamOwner")
  memberships    TeamMembership[]
  dataSources    DataSource[]
  orgOwned       Organization[]   @relation("OrgOwner")
  orgMemberships OrgMembership[]
  dashboards     Dashboard[]      @relation("DashboardCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Subscription & Payment
// ──────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  status    String @default("active") // active | cancelled | past_due | trialing
  plan      String @default("monthly") // monthly
  seatCount Int    @default(1)

  lsSubscriptionId String?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// Chat History
// ──────────────────────────────────────────────

model Chat {
  id           String   @id @default(cuid())
  userId       String
  title        String
  propertyId   String?  // GA4 property id associated with this chat
  propertyName String?  // GA4 property display name
  pinned       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId        String?

  messages ChatMessage[]

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id])

  @@index([userId])
  @@index([orgId])
}

model ChatMessage {
  id                 String  @id @default(cuid())
  chatId             String
  role               String  // "user" | "assistant"
  content            String
  scorecard          Json?   // { value, label, change? }
  scorecardRevealed  Boolean @default(false)
  suggestedQuestions Json?   // string[]
  chart              Json?   // ECharts option JSON
  sortOrder          Int     // ordering within the chat

  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

// ──────────────────────────────────────────────
// Email Alerts
// ──────────────────────────────────────────────

model EmailAlert {
  id     String @id @default(cuid())
  userId String

  name         String?  // user-defined display name for this alert
  recipients   String   // comma-separated email addresses
  alertType    String   @default("weekly_snapshot") // alert prompt template key
  customPrompt String?  // user-defined prompt for "custom" alertType
  propertyId   String?  // GA4 property id
  propertyName String?  // GA4 property display name
  enabled      Boolean  @default(true)
  lastSentAt   DateTime?

  // Custom schedule fields
  sendDays      String[] @default(["monday"]) // e.g. ["monday", "wednesday", "friday"]
  sendHour      Int      @default(9)          // 0-23, hour of day in UTC
  sendMinute    Int      @default(0)          // 0 or 30
  intervalWeeks Int      @default(1)          // 1 = every week, 2 = biweekly, 4 = monthly

  orgId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id])

  @@index([userId])
  @@index([orgId])
  @@index([enabled, sendHour])
}

model Payment {
  id     String @id @default(cuid())
  userId String

  amount   Int    // in kobo/cents
  currency String @default("ZAR")
  status   String // success | failed | pending

  lsOrderId    String?
  reference    String? @unique

  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// Team Management
// ──────────────────────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  TeamMembership[]
  invites      TeamInvite[]
  dataSources  DataSource[]
}

model TeamMembership {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("member") // "admin" | "member"
  properties String[] // GA4 property IDs this member can access
  createdAt  DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email      String
  properties String[]
  token      String    @unique @default(cuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([teamId, email])
}

// ──────────────────────────────────────────────
// Articles / Docs (database-backed content)
// ──────────────────────────────────────────────

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  section     String   @default("docs") // docs | blog
  category    String   @default("getting-started")
  type        String   @default("article") // article | video | guide
  readTime    String?
  duration    String?
  featured    Boolean  @default(false)
  author      String?
  keywords    String[] @default([])
  coverImage  String?  // URL to cover image (1200x630, used in cards + OG)
  content     String   // raw MDX content (including frontmatter)
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, category])
}

// ──────────────────────────────────────────────
// Data Sources (BigQuery integration)
// ──────────────────────────────────────────────

model DataSource {
  id         String   @id @default(cuid())
  userId     String
  teamId     String?
  orgId      String?
  type       String   @default("GA4_BIGQUERY") // GA4_BIGQUERY | GOOGLE_ADS | STRIPE | SEARCH_CONSOLE | HUBSPOT
  propertyId String                            // GA4 property ID (or Ads customer ID for GOOGLE_ADS)
  bigqueryDataset String?                      // e.g. "analytics_123456789" or "ads_1234567890"
  adsCustomerId   String?                      // Google Ads customer ID (without dashes)
  ga4PropertyId   String?                      // GA4 property this Ads account is linked to
  dtsTransferId   String?                      // BigQuery Data Transfer Service config name
  status     String   @default("PENDING")      // PENDING | ACTIVE | BACKFILLING | ERROR

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id])

  @@unique([userId, propertyId, type])
  @@index([userId])
  @@index([propertyId])
  @@index([orgId])
}

// ──────────────────────────────────────────────
// Organizations (account-centric model)
// ──────────────────────────────────────────────

model Organization {
  id              String  @id @default(cuid())
  name            String
  imageUrl        String?
  ownerId         String
  displayCurrency String  @default("USD") // ISO 4217 code (e.g. USD, ZAR, EUR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User            @relation("OrgOwner", fields: [ownerId], references: [id])
  memberships OrgMembership[]
  invites     OrgInvite[]
  dataSources DataSource[]
  chats       Chat[]
  emailAlerts EmailAlert[]
  dashboards  Dashboard[]
}

// ──────────────────────────────────────────────
// Dashboards
// ──────────────────────────────────────────────

model Dashboard {
  id        String   @id @default(cuid())
  orgId     String
  createdBy String
  title     String
  layout    Json     @default("[]") // react-grid-layout Layout[] → {i,x,y,w,h}[]
  dateRange String   @default("28d") // "7d" | "28d" | "90d" | "custom"
  dateFrom  String?  // YYYY-MM-DD, only when dateRange="custom"
  dateTo    String?  // YYYY-MM-DD, only when dateRange="custom"
  sortOrder Int      @default(0) // ordering in the dashboard list

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator User         @relation("DashboardCreator", fields: [createdBy], references: [id])
  widgets Widget[]

  @@index([orgId])
  @@index([createdBy])
}

model Widget {
  id          String @id @default(cuid())
  dashboardId String

  prompt      String   // What the user originally asked
  widgetType  String   @default("chart") // "chart" | "scorecard" | "table"
  queryConfig Json     // { tool, input, source } — everything needed to re-run the query
  displayConfig Json   // ECharts option template (chart), { label, format } (scorecard), { columns } (table)
  cachedData  Json?    // Last fetched query result rows
  cachedAt    DateTime?
  title       String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

model OrgMembership {
  id     String @id @default(cuid())
  orgId  String
  userId String
  role   String @default("member") // "admin" | "member"

  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model OrgInvite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  token      String    @unique @default(cuid())
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
}
